# Cloudflare Realtime TURN (server-side only). Powers /api/ice.
# Create at: Cloudflare dashboard → Realtime → TURN → create app.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional self-hosted PeerJS signaling broker (defaults to 0.peerjs.com cloud).
# Set these if the public broker is blocked on some network/device.
# NEXT_PUBLIC_PEER_HOST=
# NEXT_PUBLIC_PEER_PORT=443
# NEXT_PUBLIC_PEER_PATH=/
# NEXT_PUBLIC_PEER_SECURE=true
# NEXT_PUBLIC_PEER_KEY=peerjs
